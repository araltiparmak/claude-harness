// Who calls whom across services. Red edges: a dependency cycle to break.
digraph deps {
  graph [rankdir=LR, fontname="Helvetica", fontsize=20, label="Service dependencies   (red: cycle catalog -> pricing -> promotions -> catalog)", labelloc=t, nodesep=0.35, ranksep=0.9, pad=0.4];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=15, margin="0.18,0.08"];
  edge  [color="#64748b", arrowsize=0.7];

  subgraph cluster_entry {
    label="Entry points"; style="rounded,dashed"; color="#cbd5e1"; fontsize=15;
    web [label="Web shop"]; app [label="Mobile BFF"];
  }
  subgraph cluster_shared {
    label="Shared"; style="rounded,dashed"; color="#cbd5e1"; fontsize=15;
    node [fillcolor="#f1f5f9", color="#94a3b8"];
    auth [label="Auth"]; notifications [label="Notifications"];
  }

  web -> {checkout catalog account};
  app -> {checkout catalog};
  checkout -> {pricing inventory payments orders auth};
  orders -> {inventory notifications invoicing};
  invoicing -> payments;
  payments -> fraud;
  account -> {auth notifications};
  catalog -> search;

  edge [color="#dc2626", penwidth=2.2, fontcolor="#dc2626", fontname="Helvetica", fontsize=13];
  catalog -> pricing [label="price list"];
  pricing -> promotions [label="active promos"];
  promotions -> catalog [label="eligible products"];
}
