# Where the checkout timeout lives. One color per component type.
direction: right

classes: {
  group: { style: { fill: "#f4f6f8"; stroke: "#c9d1d9"; font-size: 24; border-radius: 10 } }
  svc: { style: { fill: "#dbeafe"; stroke: "#2563eb"; font-size: 22; border-radius: 8 } }
  data: { shape: cylinder; style: { fill: "#dcfce7"; stroke: "#16a34a"; font-size: 22 } }
  msg: { shape: queue; style: { fill: "#fef3c7"; stroke: "#d97706"; font-size: 22 } }
  ext: { style: { fill: "#f3e8ff"; stroke: "#7c3aed"; font-size: 22; border-radius: 8; stroke-dash: 4 } }
  e: { style: { font-size: 18; stroke-width: 2 } }
}

customer: Customer { shape: person; style.font-size: 22 }
psp: Payment provider { class: ext }

shop: Shop platform { class: group
  direction: down
  web: Web shop { class: svc }
  api: Orders API { class: svc }
  db: Orders DB { class: data }
  timer: Expiry job (every minute) { class: svc }
  events: Order events { class: msg }
  stock: Stock service { class: svc }

  web -> api: "1 place order" { class: e }
  api -> db: "2 save PENDING" { class: e }
  timer -> api: "expire after 30 min" { class: e }
  api -> events: "order paid / cancelled" { class: e }
  events -> stock: "release or confirm stock" { class: e }
}

customer -> shop.web: checkout { class: e }
shop.web -> psp: "3 pay" { class: e }
psp -> shop.api: "4 webhook: paid" { class: e }
